{
  "pluginAlias": "SolarmanMonitor",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Homebridge plugin for SOLARMAN solar inverter monitoring.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Solarman"
      },
      "email": {
        "title": "Email",
        "type": "string",
        "required": true,
        "description": "Your SOLARMAN account email"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true,
        "description": "Your SOLARMAN account password"
      },
      "plantId": {
        "title": "Plant ID",
        "type": "integer",
        "required": false,
        "description": "Plant/Station ID (auto-detected if omitted)"
      },
      "pollingInterval": {
        "title": "Polling Interval (seconds)",
        "type": "integer",
        "required": false,
        "default": 60,
        "minimum": 30,
        "maximum": 600
      },
      "token": {
        "title": "API Token",
        "type": "string",
        "required": false,
        "description": "Pre-configured API token from globalpro.solarmanpv.com (use this if OAuth login returns empty data)"
      }
    }
  }
}